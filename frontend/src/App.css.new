.landing-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(73, 214, 158, 0.18), transparent 28%),
    radial-gradient(circle at 85% 10%, rgba(255, 192, 91, 0.16), transparent 24%),
    linear-gradient(135deg, #04130f 0%, #0c241d 42%, #071713 100%);
  color: #f7efe2;
  padding: 0 24px 56px;
  position: relative;
  overflow: hidden;
}

.landing-page::before,
.landing-page::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  filter: blur(30px);
  pointer-events: none;
  z-index: 0;
}

.landing-page::before {
  width: 360px;
  height: 360px;
  top: -90px;
  right: -70px;
  background: rgba(73, 214, 158, 0.12);
  animation: floatGlow 12s ease-in-out infinite;
}

.landing-page::after {
  width: 280px;
  height: 280px;
  bottom: -80px;
  left: -80px;
  background: rgba(255, 192, 91, 0.12);
  animation: floatGlow 16s ease-in-out infinite reverse;
}

@keyframes floatGlow {
  0%,
  100% {
    transform: translate3d(0, 0, 0) scale(1);
  }
  50% {
    transform: translate3d(10px, -18px, 0) scale(1.06);
  }
}

.hero-section {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  margin: 0 auto;
  padding: 78px 0 56px;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 24px;
  align-items: center;
}

.hero-badge,
.eyebrow,
.hero-card-topline {
  display: inline-block;
  font-size: 0.78rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: #71efb3;
  font-weight: 700;
}

.hero-badge {
  margin-bottom: 16px;
  padding: 8px 12px;
  border: 1px solid rgba(113, 239, 179, 0.3);
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(113, 239, 179, 0.15), rgba(255, 192, 91, 0.12));
}

.hero-content h1,
.section-heading h2,
.split-section h2,
.cta-section h2 {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: #ffffff;
  margin: 0 0 16px;
  line-height: 1.05;
  letter-spacing: -0.02em;
}

.hero-content h1 {
  font-size: clamp(2.4rem, 4.3vw, 3.9rem);
  max-width: 760px;
}

.hero-text,
.section-text,
.service-card p,
.process-card p,
.cta-section p {
  color: #dce8df;
  font-size: 1rem;
  line-height: 1.75;
}

.topbar-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

.topbar-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 14px;
  border-radius: 999px;
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 600;
  transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
}

.topbar-btn:hover {
  transform: translateY(-1px);
}

.topbar-btn-outline {
  color: #f7efe2;
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.06);
}

.topbar-btn-solid {
  background: linear-gradient(135deg, #6ff2b9, #f0b34d);
  color: #072117;
}

.hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin: 24px 0 30px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 18px;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 26px rgba(0, 0, 0, 0.24);
}

.btn-primary {
  background: linear-gradient(135deg, #6ff2b9, #f0b34d);
  color: #072117;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.06);
  color: #f7efe2;
  border: 1px solid rgba(255, 255, 255, 0.16);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.stat-card,
.hero-card,
.service-card,
.process-card,
.highlight-panel,
.cta-section {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.035));
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
  backdrop-filter: blur(14px);
}

.stat-card {
  padding: 16px;
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  border-top: 2px solid rgba(111, 242, 185, 0.6);
}

.stat-card strong {
  font-size: 1.25rem;
  color: #ffffff;
}

.hero-card {
  border-radius: 24px;
  padding: 26px;
  position: relative;
  overflow: hidden;
}

.hero-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(111, 242, 185, 0.12), transparent 42%, rgba(255, 192, 91, 0.12));
  pointer-events: none;
}

.hero-card h2 {
  font-size: 1.35rem;
  color: #ffffff;
  margin: 10px 0 14px;
  position: relative;
}

.hero-card ul {
  padding-left: 18px;
  color: #dce8df;
  display: grid;
  gap: 10px;
  position: relative;
}

.hero-card ul li::marker {
  color: #71efb3;
}

.section {
  max-width: 1240px;
  margin: 0 auto 28px;
  padding: 32px 0;
}

.section-heading {
  margin-bottom: 20px;
}

.section-heading h2,
.split-section h2 {
  font-size: clamp(1.6rem, 2.4vw, 2.2rem);
}

.services-grid,
.process-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.service-card,
.process-card {
  padding: 22px;
  border-radius: 18px;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.service-card:hover,
.process-card:hover,
.highlight-panel:hover,
.stat-card:hover {
  transform: translateY(-3px);
  border-color: rgba(111, 242, 185, 0.36);
}

.service-icon {
  font-size: 1.7rem;
  margin-bottom: 8px;
  color: #71efb3;
}

.service-card h3,
.process-card h3,
.highlight-panel h3 {
  color: #ffffff;
  margin: 0 0 8px;
}

.split-section {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 20px;
  align-items: center;
}

.highlight-panel {
  padding: 22px;
  border-radius: 20px;
}

.highlight-panel ul {
  padding-left: 18px;
  color: #dce8df;
  display: grid;
  gap: 10px;
}

.process-step {
  display: inline-block;
  color: #f0b34d;
  font-weight: 700;
  margin-bottom: 8px;
}

.cta-section {
  max-width: 1240px;
  margin: 0 auto;
  padding: 30px;
  border-radius: 24px;
  text-align: center;
  border-top: 2px solid rgba(111, 242, 185, 0.4);
}

.footer {
  max-width: 1240px;
  margin: 20px auto 0;
  padding: 0 20px 24px;
}

.footer-content {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 20px;
  padding: 28px;
  border-radius: 24px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.06));
  border: 1px solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(12px);
}

.footer-brand,
.footer-section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.footer h3,
.footer h4 {
  color: #ffffff;
  margin: 0;
}

.footer p,
.footer-list li {
  color: #dce8df;
  margin: 0;
}

.footer-badge {
  display: inline-flex;
  align-self: flex-start;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(111, 242, 185, 0.14);
  color: #8ef4ca;
  font-size: 0.9rem;
  font-weight: 600;
}

.footer-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 6px;
}

@media (max-width: 980px) {
  .hero-section,
  .split-section {
    grid-template-columns: 1fr;
  }

  .services-grid,
  .process-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .landing-page {
    padding: 0 16px 40px;
  }

  .hero-section {
    padding-top: 40px;
  }

  .stats-grid,
  .services-grid,
  .process-grid,
  .footer-content {
    grid-template-columns: 1fr;
  }

  .footer-content {
    padding: 22px;
  }
}

.auth-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background: linear-gradient(135deg, #071b14, #103225);
}

.auth-card {
  width: 100%;
  max-width: 440px;
  padding: 32px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(12px);
  color: #f8f3e7;
}

.auth-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #e2b24f;
  text-decoration: none;
  margin-bottom: 20px;
  font-weight: 600;
}

.auth-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.auth-brand-mark {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: linear-gradient(135deg, #e7c06d, #c9921d);
  color: #10241b;
  font-weight: 700;
}

.auth-brand h2 {
  margin: 0;
  font-size: 1.1rem;
}

.auth-brand p,
.auth-description,
.auth-footer {
  margin: 2px 0 0;
}
